# Copy to .env.local (local dev) and set the same keys in Vercel
# (Project → Settings → Environment Variables).
# If the Supabase pair is blank the app runs in demo mode on the
# curated fixtures in src/data/.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: custom map tiles (default: OpenStreetMap). For heavy traffic use a
# tile provider such as MapTiler or Stadia, e.g.
# https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_MAP_TILE_URL=

# Only for scripts/import-wikidata.ts (never expose to the browser!)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
